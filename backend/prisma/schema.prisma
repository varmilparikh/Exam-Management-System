// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  COE
  HOD
  FACULTY
}

model Department {
  id String @id @default(uuid())

  name String @unique

  employees Employee[]

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("departments")
}

model Employee {
  // Primary Key
  id String @id @default(uuid())

  // Basic Information
  employeeCode String  @unique
  name         String
  email        String  @unique
  phone        String?

  googleId String? @unique

  microsoftId String? @unique

  // Authentication
  password String?

  loginProvider LoginProvider @default(LOCAL)

  isEmailVerified Boolean @default(false)

  lastLogin DateTime?

  // Profile
  profileImage String? @default("/default-avatar.png")

  designation String

  role Role @default(FACULTY)

  // Duty Statistics
  averageDuty   Int @default(10)
  attendedCount Int @default(0)
  transferCount Int @default(0)

  // Account Status
  isActive Boolean @default(true)

  isDeleted Boolean @default(false)

  // Department Relation
  departmentId String

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Exam Duties
  duties ExamDuty[]

  // Notifications
  notifications Notification[]

  // Activity Logs
  activityLogs ActivityLog[]

  // Approval Requests
  approvalRequests ApprovalRequest[] @relation("RequestOwner")

  approvedRequests ApprovalRequest[] @relation("RequestApprover")

  // Transfers
  transfersGiven TransferRequest[] @relation("TransferFrom")

  transfersReceived TransferRequest[] @relation("TransferTo")

  approvedTransfers TransferRequest[] @relation("TransferApprovedBy")

  // Swap Requests
  swapRequestsSent SwapRequest[] @relation("SwapRequester")

  swapRequestsReceived SwapRequest[] @relation("SwapReceiver")

  approvedSwapRequests SwapRequest[] @relation("SwapApprover")

  // Timestamps
  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // Indexes
  @@index([email])
  @@index([employeeCode])
  @@index([departmentId])
  @@index([role])
  @@index([isDeleted, isActive])
  @@map("employees")
}

enum ExamStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DutyStatus {
  ASSIGNED
  ATTENDED
  TRANSFERRED
  ABSENT
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LoginProvider {
  LOCAL
  GOOGLE
  MICROSOFT
}

enum SwapStatus {
  PENDING // Waiting for receiver
  ACCEPTED // Receiver accepted, waiting for COE
  APPROVED // COE approved and duties swapped
  REJECTED // Receiver or COE rejected
  CANCELLED // Requester cancelled
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestType {
  OPT_OUT
  TRANSFER
  SWAP
}

model Exam {
  id String @id @default(uuid())

  examName String   @unique
  examDate DateTime

  requiredFaculty Int

  status ExamStatus

  duties ExamDuty[]

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([examDate])
  @@index([status, examDate])
  @@map("exams")
}

model ExamDuty {
  id String @id @default(uuid())

  employeeId String?

  examId String

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  exam Exam @relation(fields: [examId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  isDeleted Boolean @default(false)

  status DutyStatus

  transfers TransferRequest[]

  swapRequestsAsRequester SwapRequest[] @relation("RequesterDuty")

  swapRequestsAsReceiver SwapRequest[] @relation("ReceiverDuty")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([employeeId, examId])
  @@index([isDeleted])
  @@index([employeeId])
  @@index([examId])
  @@map("exam_duties")
}

model TransferRequest {
  id String @id @default(uuid())

  fromEmployeeId String
  toEmployeeId   String?
  examDutyId     String

  status TransferStatus

  reason String?

  approvedById   String?
  approvedAt     DateTime?
  approvalRemark String?

  fromEmployee Employee @relation("TransferFrom", fields: [fromEmployeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  toEmployee Employee? @relation("TransferTo", fields: [toEmployeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  approvedBy Employee? @relation("TransferApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  examDuty ExamDuty @relation(fields: [examDutyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromEmployeeId])
  @@index([toEmployeeId])
  @@index([examDutyId])
  @@index([status])
  @@index([status, createdAt])
  @@map("transfer_requests")
}

model SwapRequest {
  id String @id @default(uuid())

  requesterId String

  receiverId String

  requesterDutyId String

  receiverDutyId String

  status SwapStatus

  reason String?

  approvedById String?
  approvedBy   Employee? @relation("SwapApprover", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  approvedAt DateTime?

  approvalRemark String?

  requester Employee @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  receiver Employee @relation("SwapReceiver", fields: [receiverId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  requesterDuty ExamDuty @relation("RequesterDuty", fields: [requesterDutyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  receiverDuty ExamDuty @relation("ReceiverDuty", fields: [receiverDutyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  isDeleted    Boolean  @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@index([requesterId])
  @@index([receiverId])
  @@index([requesterDutyId])
  @@index([receiverDutyId])
  @@index([status])
  @@index([status, createdAt])
  @@index([approvedById])
  @@map("swap_requests")
}

model Notification {
  id String @id @default(uuid())

  employeeId String

  title String

  message String

  isRead Boolean @default(false)

  readAt      DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@index([employeeId])
  @@index([employeeId, isRead])
  @@map("notifications")
}

enum ActivityAction {
  LOGIN
  LOGOUT

  CREATE_DEPARTMENT
  UPDATE_DEPARTMENT
  DELETE_DEPARTMENT

  CREATE_EMPLOYEE
  UPDATE_EMPLOYEE
  DELETE_EMPLOYEE

  CREATE_EXAM
  UPDATE_EXAM
  DELETE_EXAM

  ASSIGN_EXAM_DUTY
  UPDATE_EXAM_DUTY
  DELETE_EXAM_DUTY

  CREATE_TRANSFER_REQUEST
  APPROVE_TRANSFER_REQUEST
  REJECT_TRANSFER_REQUEST
  CANCEL_TRANSFER_REQUEST

  CREATE_SWAP_REQUEST
  ACCEPT_SWAP_REQUEST
  APPROVE_SWAP_REQUEST
  CANCEL_SWAP_REQUEST
  REJECT_SWAP_REQUEST_BY_RECEIVER
  REJECT_SWAP_REQUEST_BY_COE
}

enum EntityType {
  EMPLOYEE
  DEPARTMENT
  EXAM
  EXAM_DUTY
  TRANSFER_REQUEST
  SWAP_REQUEST
}

model ActivityLog {
  id String @id @default(uuid())

  employeeId String

  action ActivityAction

  description String

  entityType EntityType?

  entityId String?

  ipAddress String?

  userAgent String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@index([employeeId])
  @@index([action])
  @@index([entityType])
  @@map("activity_logs")
}

model ApprovalRequest {
  id String @id @default(uuid())

  employeeId String

  approvedById String?

  approvedAt DateTime?

  requestType RequestType

  requestId String?

  status ApprovalStatus

  reason String?

  employee Employee @relation("RequestOwner", fields: [employeeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  approvedBy Employee? @relation("RequestApprover", fields: [approvedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([isDeleted])
  @@index([employeeId])
  @@index([employeeId, status])
  @@index([approvedById])
  @@map("approval_requests")
}
